  <metadata>
    <id>whatpulse</id>
    <version>{{VERSION}}</version>
    <packageSourceUrl>https://github.com/whatpulse/external-packages/tree/main/chocolatey/whatpulse</packageSourceUrl>
    <owners>WhatPulse</owners>
    <title>WhatPulse</title>
